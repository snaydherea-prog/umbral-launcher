{
  "name": "umbral-launcher",
  "version": "1.0.0-preview.4",
  "private": true,
  "description": "Launcher de escritorio para la comunidad Umbral",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node tools/check.mjs",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jsdom": "26.1.0"
  },
  "build": {
    "appId": "com.umbral.launcher",
    "productName": "Umbral Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Umbral-Launcher-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Umbral-Launcher-Portable-${version}-${arch}.${ext}"
    }
  }
}
